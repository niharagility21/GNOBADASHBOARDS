dist/
build/
*.min.js
*.min.css

# Temporary files
tmp/
temp/
*.tmp

# Python (if using Python for generator)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
*.egg-info/

# Coverage
coverage/
.nyc_output/
